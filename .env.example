# Legacy demo passcode. The batch desk does not accept it; staff sign in with DEV_STAFF_PASSWORD.
# DEMO_PASSCODE=goodcane-demo

# PLACEHOLDER WhatsApp number for click-to-chat (wa.me). Replace with GoodCane's
# number ONLY once GoodCane has approved it. Digits only, with country code.
NEXT_PUBLIC_GOODCANE_WHATSAPP=233000000000

# Optional persistence (otherwise an in-memory store seeded with sample data is used).
# Upstash Redis REST credentials, or the Vercel KV / Upstash Marketplace equivalents.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Postgres (Person A / Neon). If unset, memory or Upstash is used so B/C are not blocked.
# DATABASE_URL is the pooled connection (hostname contains -pooler) for the app.
# DATABASE_URL_UNPOOLED is the direct connection for drizzle-kit and psql.
# `neon env pull` writes both, plus NEON_BRANCH, into .env.
# After setting these, apply schema: npm run db:push
#   or: psql "$DATABASE_URL_UNPOOLED" -f drizzle/0000_init.sql
# DATABASE_URL=postgresql://user:pass@host-pooler/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/neondb?sslmode=require
# NEON_BRANCH=production

# Staff session (Person B). Generate a secret with: openssl rand -hex 32
# Required when NODE_ENV=production. Development uses a local fallback.
# SESSION_SECRET=
# Used only when staff_users has no matching row. Ignored when VERCEL_ENV=production.
# DEV_STAFF_PASSWORD=
# ARKESEL_API_KEY=
# SMS_SENDER_ID=GoodCane
# OTP storage and the send rate limit use the Upstash vars above.
# When those are unset, development keeps codes in memory and does not rate-limit.

# Paystack (Person C). Leave unset in local dev to use the simulated checkout.
# The return URL is built by the server. Do not put a callback URL in the client.
# PAYSTACK_SECRET_KEY=sk_test_xxxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# PAYSTACK_WEBHOOK_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hourly batch worker (Person A). Vercel Cron sends Authorization: Bearer CRON_SECRET.
# Required in production. Locally you can curl /api/cron/sync without it if unset.
# Generate with: openssl rand -hex 32
# CRON_SECRET=
