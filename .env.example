# Demo passcode for the business dashboard (shown on the login screen — demo only).
DEMO_PASSCODE=goodcane-demo

# PLACEHOLDER WhatsApp number for click-to-chat (wa.me). Replace with GoodCane's
# number ONLY once GoodCane has approved it. Digits only, with country code.
NEXT_PUBLIC_GOODCANE_WHATSAPP=233000000000

# Optional persistence (otherwise an in-memory store seeded with sample data is used).
# Upstash Redis REST credentials, or the Vercel KV / Upstash Marketplace equivalents.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Postgres (Person A / Neon). If unset, memory or Upstash is used so B/C are not blocked.
# DATABASE_URL is the pooled connection (hostname contains -pooler) for the app.
# DATABASE_URL_UNPOOLED is the direct connection for drizzle-kit and psql.
# `neon env pull` writes both, plus NEON_BRANCH, into .env.
# After setting these, apply schema: npm run db:push
#   or: psql "$DATABASE_URL_UNPOOLED" -f drizzle/0000_init.sql
# DATABASE_URL=postgresql://user:pass@host-pooler/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/neondb?sslmode=require
# NEON_BRANCH=production
